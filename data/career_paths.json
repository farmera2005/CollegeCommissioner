  "nonTraditionalHireTrend": {
    "summary": "Since 2019 power-conference boards have increasingly hired from pro leagues, media and entertainment rather than promoting ADs or conference deputies, betting that media-rights and commercial skill matter more than NCAA governance experience. Of the P4 commissioners hired 2019-2023, three of four came from outside campus athletics (Warren, Kliavkoff, Yormark, Petitti; Phillips the exception). The trend has spread to non-football leagues (Big East's Tim Brosnan from MLB, 2026). Counter-signals: the Pac-12 promoted deputy Teresa Gould (2024) after the outsider Kliavkoff failed, and Big 12 chair Doug Girod said in Oct. 2026 he wants 'campus experience' rather than a 'Yormark twin' for the next hire.",
    "examples": [
      { "person": "kevin-warren", "name": "Kevin Warren", "hiredBy": "big-ten", "year": 2019, "from": "Minnesota Vikings COO (NFL); attorney", "outcome": "Landed $7B+ Fox/CBS/NBC deal and USC/UCLA; left for Chicago Bears president/CEO in 2023" },
      { "person": "george-kliavkoff", "name": "George Kliavkoff", "hiredBy": "pac-12", "year": 2021, "from": "MGM Resorts president of entertainment & sports (earlier MLB Advanced Media, NBCUniversal/Hearst digital)", "outcome": "Media-deal failure (Apple streaming pitch) preceded the Aug. 2023 collapse; separated Feb. 2024 with ~$5M severance" },
      { "person": "brett-yormark", "name": "Brett Yormark", "hiredBy": "big-12", "year": 2022, "from": "Roc Nation COO; ex-Brooklyn Nets/Barclays CEO; ex-NASCAR marketing", "outcome": "Early $2.28B ESPN/Fox extension and Pac-12 raid; extended to 2030 then left Jan. 2027 for a RedBird-backed venture in Milan" },
      { "person": "tony-petitti", "name": "Tony Petitti", "hiredBy": "big-ten", "year": 2023, "from": "MLB deputy commissioner; MLB Network CEO; CBS Sports EVP; Activision Blizzard", "outcome": "Extended through June 2033 (Aug. 2026)" },
